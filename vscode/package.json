{
  "name": "bulkhours",
  "displayName": "BulkHours",
  "description": "A coding assistant for students: chat with an agent that reads and edits your workspace, on your school's credits.",
  "version": "0.1.18",
  "publisher": "gateka",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gtherin/bulkhours.git",
    "directory": "vscode"
  },
  "bugs": {
    "url": "https://github.com/gtherin/bulkhours/issues"
  },
  "homepage": "https://github.com/gtherin/bulkhours/tree/main/vscode#readme",
  "type": "module",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Education"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": ["workspace"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bulkhours",
          "title": "BulkHours",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "bulkhours": [
        {
          "type": "webview",
          "id": "bulkhours.chat",
          "name": "%view.assistant%"
        }
      ]
    },
    "commands": [
      {
        "command": "bulkhours.newChat",
        "title": "%command.newChat%",
        "category": "BulkHours",
        "icon": "$(add)"
      },
      {
        "command": "bulkhours.signIn",
        "title": "%command.signIn%",
        "category": "BulkHours"
      },
      {
        "command": "bulkhours.signOut",
        "title": "%command.signOut%",
        "category": "BulkHours"
      },
      {
        "command": "bulkhours.pickAgent",
        "title": "%command.pickAgent%",
        "category": "BulkHours"
      },
      {
        "command": "bulkhours.history",
        "title": "%command.history%",
        "category": "BulkHours",
        "icon": "$(history)"
      },
      {
        "command": "bulkhours.rename",
        "title": "%command.rename%",
        "category": "BulkHours",
        "icon": "$(edit)"
      },
      {
        "command": "bulkhours.restart",
        "title": "%command.restart%",
        "category": "BulkHours",
        "icon": "$(debug-restart)"
      },
      {
        "command": "bulkhours.update",
        "title": "%command.update%",
        "category": "BulkHours",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bulkhours.history",
          "when": "view == bulkhours.chat",
          "group": "navigation@1"
        },
        {
          "command": "bulkhours.newChat",
          "when": "view == bulkhours.chat",
          "group": "navigation@2"
        },
        {
          "command": "bulkhours.rename",
          "when": "view == bulkhours.chat",
          "group": "1_conversation@1"
        },
        {
          "command": "bulkhours.restart",
          "when": "view == bulkhours.chat",
          "group": "2_extension@1"
        },
        {
          "command": "bulkhours.update",
          "when": "view == bulkhours.chat",
          "group": "2_extension@2"
        }
      ]
    },
    "configuration": {
      "title": "BulkHours",
      "properties": {
        "bulkhours.agent": {
          "type": "string",
          "default": "",
          "description": "%setting.agent%"
        },
        "bulkhours.extraAgents": {
          "type": "array",
          "default": [],
          "description": "%setting.extraAgents%",
          "items": {
            "type": "object"
          }
        },
        "bulkhours.imageModels": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "%setting.imageModels%"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit -p .",
    "test": "node --test --experimental-strip-types --experimental-test-module-mocks --no-warnings test/*.test.ts",
    "package": "node scripts/package-school.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vscode": "file:test/vscode-stub"
  }
}
