{
  "id": "maqi",
  "name": "MaQI",
  "title": "MaQI",
  "prefix": "maqi",
  "accent": "#61b45c",
  "stateDir": "~/.maqi",
  "downloadUrl": "https://bulkhours.fr/bkfpage/vscode/",
  "language": "fr",
  "connection": {
    "keyFile": "/run/maqi/keys/${user}/llm.env",
    "offer": {
      "models": [
        "fast",
        "code",
        "reasoning",
        "frontier"
      ],
      "default_model": "fast",
      "model_labels": {
        "fast": "DeepSeek V4 Flash",
        "code": "Kimi K2.7 Code",
        "reasoning": "GLM-5.2",
        "frontier": "Kimi K3"
      },
      "model_prices": {
        "fast": {
          "in": 0.14,
          "out": 0.28
        },
        "code": {
          "in": 0.95,
          "out": 4.0
        },
        "reasoning": {
          "in": 1.4,
          "out": 4.4
        },
        "frontier": {
          "in": 3.0,
          "out": 15.0
        }
      },
      "currency": "EUR",
      "agent": {
        "id": "maqi",
        "label": "MaQI Agent (dsh)",
        "command": "/opt/maqi-agent/bin/dsh-acp",
        "args": [
          "--patch",
          "${extensionPath}/media/agents/dsh-maqi-model.yml"
        ]
      }
    }
  }
}
