{
  "id": "maqi",
  "name": "MaQI",
  "title": "MaQI",
  "prefix": "maqi",
  "accent": "#61b45c",
  "stateDir": "~/.maqi",
  "downloadUrl": "https://bulkhours.fr/bkfpage/vscode/",
  "language": "fr",
  "avatar": "https://git.maqi.ai.msct.fr/user/avatar/${user}/64",
  "links": [
    {
      "label": "MaQI",
      "url": "https://maqi.ai.msct.fr/",
      "icon": "home"
    },
    {
      "label": "Docs",
      "url": "https://maqi.ai.msct.fr/handbook/getting-started/",
      "icon": "book"
    },
    {
      "label": "Directory",
      "url": "https://git.maqi.ai.msct.fr/org/maqi/members",
      "icon": "organization"
    },
    {
      "label": "Slack",
      "url": "https://app.slack.com/client/T0B6LP4SJTE/C0B7BDV9WPJ",
      "icon": "comment-discussion"
    },
    {
      "label": "Git",
      "url": "https://git.maqi.ai.msct.fr",
      "icon": "git-branch"
    },
    {
      "label": "Moodle",
      "url": "https://moodle.ip-paris.fr/my/courses.php",
      "icon": "mortar-board"
    }
  ],
  "connection": {
    "keyFile": "/run/maqi/keys/${user}/llm.env",
    "offer": {
      "models": [
        "fast",
        "code",
        "reasoning",
        "frontier"
      ],
      "default_model": "fast",
      "model_labels": {
        "fast": "DeepSeek V4 Flash",
        "code": "Kimi K2.7 Code",
        "reasoning": "GLM-5.2",
        "frontier": "Kimi K3"
      },
      "model_prices": {
        "fast": {
          "in": 0.14,
          "out": 0.28
        },
        "code": {
          "in": 0.95,
          "out": 4.0
        },
        "reasoning": {
          "in": 1.4,
          "out": 4.4
        },
        "frontier": {
          "in": 3.0,
          "out": 15.0
        }
      },
      "currency": "EUR",
      "agent": {
        "id": "maqi",
        "label": "MaQI Agent (dsh)",
        "command": "/opt/maqi-agent/bin/dsh-acp",
        "args": [
          "--patch",
          "${extensionPath}/media/agents/dsh-maqi-model.yml"
        ]
      }
    },
    "status": {
      "command": "/opt/tljh/user/bin/python",
      "args": [
        "${extensionPath}/media/platform/maqi-status.py",
        "${lang}"
      ]
    }
  }
}
